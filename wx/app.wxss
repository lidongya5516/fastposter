/** FastPoster 小程序 - 全局样式 */

page {
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC', sans-serif;
  background-color: #f7f8fa;
  color: #1a1a2e;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ========== 通用组件 ========== */

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.safe-bottom {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card + .card {
  margin-top: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.section-title::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  background: #07c160;
  border-radius: 4rpx;
  flex-shrink: 0;
}

/* ========== 按钮 ========== */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  border: none;
  padding: 0;
  height: 96rpx;
  width: 100%;
  transition: opacity 0.2s;
}

.btn:active {
  opacity: 0.8;
}

.btn-primary {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 24rpx rgba(7, 193, 96, 0.35);
}

.btn-primary[disabled] {
  opacity: 0.5;
  box-shadow: none;
}

.btn-secondary {
  background: #ffffff;
  color: #07c160;
  border: 2rpx solid #07c160;
  box-sizing: border-box;
}

.btn-secondary:active {
  background: #e8f8ee;
}

.btn-block {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.btn-block .btn {
  flex: 1;
}

.btn-small {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 32rpx;
  width: auto;
  border-radius: 32rpx;
}

/* ========== 表单 ========== */

.form-group {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a2e;
  margin-bottom: 12rpx;
  display: block;
}

.input-wrapper {
  display: flex;
  align-items: center;
  background: #f7f8fa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  padding: 0 24rpx;
}

.input-wrapper:focus-within,
.input-wrapper:active {
  border-color: #07c160;
  background: #ffffff;
}

.input-field {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  background: transparent;
  border: none;
  outline: none;
  padding: 0;
  width: 100%;
}

.input-field::placeholder {
  color: #b2b2b2;
}

/* ========== 状态 ========== */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
}

.empty-icon {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 24rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 28rpx;
  color: #666;
  margin-top: 8rpx;
}

.empty-desc {
  font-size: 24rpx;
  color: #b2b2b2;
  margin-top: 8rpx;
}

/* 加载骨架屏 */
.skeleton {
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 12rpx;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.tag-green {
  background: #e8f8ee;
  color: #07c160;
}

.tag-gray {
  background: #f0f0f0;
  color: #999;
}

/* ========== 悬浮返回首页按钮 ========== */

.home-fab {
  position: fixed;
  right: 32rpx;
  bottom: 260rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  border: 2rpx solid #f0f0f0;
}

.home-fab:active {
  opacity: 0.7;
  transform: scale(0.92);
}

.home-fab-icon {
  width: 44rpx;
  height: 44rpx;
}
