/* ========== 顶部标题栏 ========== */

.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 16rpx;
}

.header-left {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.header-count {
  font-size: 24rpx;
  color: #b2b2b2;
}

.header-right {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.refresh-icon {
  width: 36rpx;
  height: 36rpx;
}

.refreshing {
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  100% { transform: rotate(360deg); }
}

/* ========== 骨架屏 ========== */

.skeleton-list {
  padding: 0 24rpx;
}

.skeleton-card {
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.skeleton-img {
  width: 100%;
  height: 360rpx;
}

.skeleton-info {
  padding: 24rpx;
}

.skeleton-title {
  width: 40%;
  height: 32rpx;
  margin-bottom: 16rpx;
}

.skeleton-time {
  width: 30%;
  height: 24rpx;
}

/* ========== 海报列表 ========== */

.poster-list {
  padding: 0 24rpx 32rpx;
}

.poster-card {
  position: relative;
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.poster-card:active {
  opacity: 0.9;
}

.poster-img {
  width: 100%;
  height: 360rpx;
  display: block;
  background: #f0f0f0;
}

.poster-mask {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 120rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
  pointer-events: none;
}

.poster-info {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 28rpx 24rpx;
  z-index: 1;
}

.poster-name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  text-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 4rpx;
}

.poster-time {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ========== 加载动画 ========== */

.load-more {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8rpx;
  padding: 32rpx;
}

.load-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #07c160;
  animation: bounce 1.2s ease-in-out infinite;
}

.load-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.load-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}
