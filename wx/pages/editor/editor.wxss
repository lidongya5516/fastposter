/* ========== 编辑器头部 ========== */

.editor-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 28rpx 28rpx 16rpx;
}

.editor-header-left {
  flex: 1;
  min-width: 0;
}

.editor-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  display: block;
  line-height: 1.4;
}

.editor-sub {
  font-size: 24rpx;
  color: #b2b2b2;
  margin-top: 6rpx;
  display: block;
}

.editor-size {
  flex-shrink: 0;
  margin-left: 16rpx;
  margin-top: 6rpx;
}

.size-text {
  font-size: 22rpx;
  color: #b2b2b2;
  background: #f5f5f5;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.editor-preview {
  width: 100%;
  display: block;
  background: #f0f0f0;
  min-height: 200rpx;
}

.editor-preview[src=""] {
  display: none;
}

/* ========== 变量填写 ========== */

.var-item {
  margin-bottom: 28rpx;
  border-bottom: 2rpx solid #f0f0f0;
  padding-bottom: 28rpx;
}

.var-item:last-child {
  border-bottom: none;
  margin-bottom: 0;
  padding-bottom: 0;
}

.var-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.var-tag {
  font-size: 20rpx;
  flex-shrink: 0;
}

.var-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a2e;
}

.var-item .input-field {
  background: #f7f8fa;
  height: 80rpx;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.var-item .input-field:focus {
  border-color: #07c160;
  background: #ffffff;
}

/* 图片上传输入框 */
.img-input {
  display: flex;
  gap: 16rpx;
}

.img-input-field {
  flex: 1;
  min-width: 0;
}

.upload-btn {
  flex-shrink: 0;
  height: 80rpx;
  padding: 0 28rpx;
  background: #e8f8ee;
  color: #07c160;
  border: none;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 80rpx;
  white-space: nowrap;
}

.upload-btn:active {
  opacity: 0.7;
}

/* ========== 底部操作栏 ========== */

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
  z-index: 100;
}

/* ========== 页边距：为底部固定栏留空间 ========== */

.page {
  padding-bottom: 200rpx;
}
