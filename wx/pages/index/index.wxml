<view class="page">
  <!-- 未配置状态 -->
  <block wx:if="{{!configured}}">
    <view class="empty-state">
      <image class="empty-icon" src="/images/empty.png" mode="aspectFit"></image>
      <text class="empty-title">尚未配置服务器</text>
      <text class="empty-desc">请先设置服务器地址和 Token</text>
      <button class="btn btn-primary" style="width:400rpx;margin-top:48rpx;" bindtap="goSettings">前往设置</button>
    </view>
  </block>

  <!-- 已配置 -->
  <block wx:else>
    <!-- 顶部标题栏 -->
    <view class="header-bar">
      <view class="header-left">
        <text class="header-title">海报模板</text>
        <text class="header-count" wx:if="{{posters.length > 0}}">{{posters.length}}个模板</text>
      </view>
      <view class="header-right" bindtap="onRefresh">
        <image class="refresh-icon {{refreshing ? 'refreshing' : ''}}" src="/images/refresh.png"></image>
      </view>
    </view>

    <!-- 骨架屏 -->
    <view class="skeleton-list" wx:if="{{loading && posters.length === 0}}">
      <view class="skeleton-card" wx:for="{{3}}" wx:key="index">
        <view class="skeleton skeleton-img"></view>
        <view class="skeleton-info">
          <view class="skeleton skeleton-title"></view>
          <view class="skeleton skeleton-time"></view>
        </view>
      </view>
    </view>

    <!-- 海报列表 -->
    <view class="poster-list" wx:elif="{{posters.length > 0}}">
      <view
        class="poster-card"
        wx:for="{{posters}}"
        wx:key="id"
        data-id="{{item.id}}"
        data-code="{{item.code}}"
        bindtap="goEditor"
      >
        <image
          class="poster-img"
          src="{{item.previewUrl}}"
          mode="aspectFill"
          lazy-load
        ></image>
        <view class="poster-mask"></view>
        <view class="poster-info">
          <text class="poster-name">{{item.name}}</text>
          <text class="poster-time">{{item.updateTime}}</text>
        </view>
      </view>
    </view>

    <!-- 空列表 -->
    <view class="empty-state" wx:elif="{{!loading}}">
      <image class="empty-icon" src="/images/empty.png" mode="aspectFit"></image>
      <text class="empty-title">暂无海报模板</text>
      <text class="empty-desc">请通过管理后台创建海报模板</text>
    </view>

    <!-- 上拉加载/状态 -->
    <view class="load-more" wx:if="{{loading && posters.length > 0}}">
      <view class="load-dot"></view>
      <view class="load-dot"></view>
      <view class="load-dot"></view>
    </view>
  </block>
</view>
